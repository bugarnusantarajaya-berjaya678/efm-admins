# EFM Backend — Environment Configuration
# Copy to .env and fill in values. Missing required vars will crash on startup.

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://efm_user:efm_password@localhost:5432/efm_db

# Test database (used by jest)
TEST_DATABASE_URL=postgresql://efm_user:efm_password@localhost:5432/efm_test_db

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info

# ─── Phase 3: Supabase Storage & Auth ────────────────────────────────────────
# Supabase project URL (from Project Settings > API > Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service Role key — server-side only, NEVER send to frontend
# (from Project Settings > API > Service Role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT Secret — used to verify tokens issued by Supabase Auth
# (from Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret-here

# Anonymous / public key — safe to send to frontend (used for client-side auth)
# (from Project Settings > API > anon public key)
SUPABASE_ANON_KEY=your-anon-key-here

# Upload size limits (bytes)
# Default: 10 MB for payment proofs, 20 MB for attendance photos
PROOF_MAX_BYTES=10485760
PHOTO_MAX_BYTES=20971520
