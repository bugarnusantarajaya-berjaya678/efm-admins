# EFM Backend — Environment Configuration
# Copy to .env and fill in values. Missing required vars will crash on startup.

# Server
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=postgresql://efm_user:efm_password@localhost:5432/efm_db

# Test database (used by jest)
TEST_DATABASE_URL=postgresql://efm_user:efm_password@localhost:5432/efm_test_db

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info
